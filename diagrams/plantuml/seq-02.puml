@startuml
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 14
skinparam sequenceParticipantType rectangle
skinparam sequenceLifeLineBorderColor Black
skinparam linetype ortho

title Sequence: PATCH /collections/{name}/objects/{id} — проверка api_key

actor "Клиент (Postman)" as Client
participant "API Service" as API
database "Хранилище объектов/коллекций" as DB

autonumber 1

Client -> API: PATCH /collections/{collectionName}/objects/{objectId}\nHeader: X-API-Key: <api_key>\nBody: { "name": "Новое имя" }
activate API

alt api_key отсутствует / невалиден
  note right of API
    Обязательный параметр X-API-Key:
    - не передан,
    - не совпадает,
    - переменная не подставилась.
  end note
  API --> Client: 403 Forbidden\n"API key missing"
  deactivate API
else api_key валиден, объект найден, пользователь — владелец
  API -> DB: 1) Проверить существование коллекции и объекта\n2) Получить owner_id объекта
  activate DB
  DB --> API: Объект найден, owner_id совпадает с владельцем коллекции
  deactivate DB

  API -> DB: Обновить поля объекта
  activate DB
  DB --> API: Обновление подтверждено
  deactivate DB

  API --> Client: 200 OK\n{ обновлённый объект }
  deactivate API
else api_key валиден, но объект не найден
  API -> DB: Проверить существование коллекции и объекта
  activate DB
  DB --> API: Коллекция или объект не найдены
  deactivate DB

  API --> Client: 404 Not Found\n"Object with id={objectId} was not found"
  deactivate API
end alt
@enduml
